# Local Python environment: rebuild with requirements.txt
.venv/
__pycache__/
*.pyc

# ToolSafe is fetched at a pinned commit (see README, "Set up"). Its scripts contain hardcoded
# API keys, so it never goes in this repo.
vendor/ToolSafe/

# Rebuilt by scripts/make_kaggle_bundle.py
kaggle/tsbench-probe-bundle.zip

# Kaggle download zips: the same files are unpacked in results/
results/*.zip

# Task-recovery pilot: saved model calls, only useful for resuming a run (episodes.jsonl has the transcripts)
results/*/memo.jsonl

# Cached activations live on Kaggle (several GB), or in work/ for scripts/run_model.py
acts/
work/
